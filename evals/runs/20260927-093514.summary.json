      {
        "id": "git_commit",
        "when": {
          "tools": [
            "Bash"
          ]
        },
        "question": "Does this tool call create a git commit?"
      },
      {
        "id": "git_commit_pattern",
        "when": {
          "tools": [
            "Bash"
          ]
        },
        "pattern": "\\bgit\\s+(-[cC]\\s+(\"[^\"]*\"|\\S+)\\s+)*commit\\b"
      },
